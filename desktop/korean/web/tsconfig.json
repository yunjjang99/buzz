{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "*.tsx",
    "../runtime/locale.ts",
    "../runtime/messages.ts"
  ],
  "exclude": ["vite.config.ts", "playwright.config.ts"]
}
